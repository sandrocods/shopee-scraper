    "product_description": {
      "paragraph_list": [
        {
          "text": "Pulley Only KZR",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": null,
