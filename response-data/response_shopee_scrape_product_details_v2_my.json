    "product_description": {
      "paragraph_list": [
        {
          "text": "Elevate your everyday care routine with Eclipse Plus Mints, available in two delightful flavors: Honey Lemon and Loquat Pear. These sugar-free mints are thoughtfully crafted using a blend of traditional herbs like luohanguo, honeysuckle, and chrysanthemum, known for their beneficial throat-soothing properties. Each flavor offers a unique and refreshing experience, perfect for maintaining fresh breath and a comfortable throat throughout the day.",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": null,
          "type": 10001,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": 1
        },
        {
          "text": "-Traditional Herb Blend: Infused with luohanguo, honeysuckle, and chrysanthemum, which are well-regarded for their throat care benefits.",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": "-Flavor Options: Choose between Honey Lemon, with its sweet and sour notes, or Loquat Pear, featuring a unique and refreshing fruit blend.",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": "-Soothing Mint: Each mint provides a comforting, mouth-watering taste that cools and soothes the throat.",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": "-Sugar-Free: Enjoy long-lasting freshness without the sugar, making these mints a healthier choice.",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": null,
          "type": 10001,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": 1
        },
        {
          "text": "Experience the dual benefits of refreshing breath and throat comfort with Eclipse Plus Mints in Honey Lemon and Loquat Pear flavors. Perfect for daily use, these mints are your go-to solution for everyday voice and throat care.",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        }
      ],
