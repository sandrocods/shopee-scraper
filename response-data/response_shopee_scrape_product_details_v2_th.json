    "translation_status": 0,
    "exclusive_price_cta": null,
    "product_description": {
      "paragraph_list": [
        {
          "text": "ชุดเอี๊ยม ผ้ากันเปื้อน กันน้ํามัน ทรงหลวม สําหรับเด็กทารก ผ้ากันเปื้อนเด็ก",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": null,
          "type": 10001,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": 1
        },
        {
          "text": "รายละเอียดสินค้า",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": null,
          "type": 10001,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": 1
        },
        {
          "text": "ผลิตภัณฑ์นี้ป้องกันไม่ให้ทารกกินและเปื้อนเสื้อผ้าได้อย่างมีประสิทธิภาพการรับประทานอาหารด้วยตัวเองเป็นเรื่องง่ายที่จะเปื้อนเสื้อผ้าและเก้าอี้รับประทานอาหารด้วยเสื้อผ้าป้องกันสิ่งสกปรกสำหรับทารกคุณแม่และคุณพ่อไม่ต้องกังวล เนื่องจากเป็นผลิตภัณฑ์สำหรับเด็กโปรดมั่นใจได้ว่าผ้า",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": null,
          "type": 10001,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": 1
        },
        {
          "text": "การออกแบบสองชั้น: การออกแบบสองชั้น: ผ้า EVA เกรดอาหารกันน้ำและกันน้ำมันชั้นในเป็นผ้าระบายอากาศและเป็นมิตรกับผิวหนังทารกจะไม่ทำให้เสื้อผ้าเปียกภายในเมื่อดื่มน้ำและซุปโดยมีที่เก็บของตัวเอง กระเป๋าใส่กระเป๋า",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": null,
          "type": 10001,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": 1
        },
        {
          "text": "การปกปิดด้านหลัง: สัมผัสโดยตรงกับทั้งหลังและอากาศระบายอากาศได้ดีและไม่หมองคล้ำ",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": null,
          "type": 10001,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": 1
        },
        {
          "text": "ด้านล่างของผลิตภัณฑ์: สามารถเก็บเสื้อผ้าให้แน่นที่ด้านล่างของบอร์ดรับประทานอาหารของเก้าอี้รับประทานอาหารและจะไม่มีการตั้งอยู่ที่ลิฟท์หรือลิฟท์ของทารก",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": "เก้าอี้ทานอาหารแบบไม่เลือกเหมาะสำหรับเก้าอี้รับประทานอาหาร 99% ในตลาด",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": null,
          "type": 10001,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": 1
        },
        {
          "text": "จัดส่งในประเทศไทย ส่งจากกรุงเทพฯ โดยปกติภายในหนึ่งวันหลังจากสั่งซื้อ (ยกเว้นวันหยุดสุดสัปดาห์และวันหยุดนักขัตฤกษ์)",
          "type": 0,
          "ratio": null,
          "img_id": null,
