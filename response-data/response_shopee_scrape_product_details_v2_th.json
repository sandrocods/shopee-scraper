      "rich_text_description": {
        "paragraph_list": [
          {
            "text": "- ถุงพลาสติก ถุงขยะดำ เหนียวพิเศษ",
            "type": 0,
            "ratio": null,
            "img_id": null,
            "description_type": 1,
            "empty_paragraph_count": null
          },
          {
            "text": "- มี 8 ขนาด ",
            "type": 0,
            "ratio": null,
            "img_id": null,
            "description_type": 1,
            "empty_paragraph_count": null
          },
          {
            "text": "18x20 นิ้ว = 75 ใบ",
            "type": 0,
            "ratio": null,
            "img_id": null,
            "description_type": 1,
            "empty_paragraph_count": null
          },
          {
            "text": "22x30 นิ้ว = 40 ใบ",
            "type": 0,
            "ratio": null,
            "img_id": null,
            "description_type": 1,
            "empty_paragraph_count": null
          },
          {
            "text": "24x28 นิ้ว = 40 ใบ",
            "type": 0,
            "ratio": null,
            "img_id": null,
            "description_type": 1,
            "empty_paragraph_count": null
          },
          {
            "text": "26x34 นิ้ว = 30 ใบ",
            "type": 0,
            "ratio": null,
            "img_id": null,
            "description_type": 1,
            "empty_paragraph_count": null
          },
          {
            "text": "28x36 นิ้ว = 25 ใบ",
            "type": 0,
            "ratio": null,
            "img_id": null,
            "description_type": 1,
            "empty_paragraph_count": null
          },
          {
            "text": "30x40 นิ้ว = 20 ใบ",
            "type": 0,
            "ratio": null,
            "img_id": null,
            "description_type": 1,
            "empty_paragraph_count": null
          },
          {
            "text": "36x45 นิ้ว = 13 ใบ",
            "type": 0,
            "ratio": null,
            "img_id": null,
            "description_type": 1,
            "empty_paragraph_count": null
          },
          {
            "text": "40x60 นิ้ว = 5 ใบ",
            "type": 0,
            "ratio": null,
            "img_id": null,
            "description_type": 1,
            "empty_paragraph_count": null
          },
          {
            "text": "- เป็นถุงขยะรักษ์โลก ผลิตจากเม็ดพลาสติกรีไซเคิล 100% (แต่ไม่เหม็นนะคะ)",
            "type": 0,
            "ratio": null,
            "img_id": null,
            "description_type": 1,
            "empty_paragraph_count": null
          },
          {
            "text": "- หนากำลังดี จำนวนใบเยอะ คุ้มค่าเหมาะกับการใช้งาน ",
            "type": 0,
            "ratio": null,
            "img_id": null,
            "description_type": 1,
            "empty_paragraph_count": null
          },
          {
            "text": "- ก้นถุงซิล 2 ชั้น ไม่รั่ว ไม่ขาดง่าย แน่นอน",
            "type": 0,
            "ratio": null,
            "img_id": null,
            "description_type": 1,
            "empty_paragraph_count": null
          },
          {
            "text": "- หากสินค้ามีปัญหา รบกวนทักแชตค่ะ ถ้ารีวิวให้ดาวน้อยแล้ว งดคืนหรือเคลมทุกกรณี",
            "type": 0,
            "ratio": null,
            "img_id": null,
            "description_type": 1,
            "empty_paragraph_count": null
          },
          {
            "text": "- ซื้อครบ 500 บาท สามารถออกใบกำกับภาษีได้ค่ะ แต่ถ้าต่ำกว่า 500 บาท สามารถออกบิลเงินสดได้ค่ะ",
            "type": 0,
            "ratio": null,
            "img_id": null,
            "description_type": 1,
            "empty_paragraph_count": null
          },
          {
            "text": "- ส่งพัสดุวันจันทร์-เสาร์ ตัดรอบเวลาเช้า 10:30 น. (ลูกค้าที่สั่งหลัง 10:30 น. ส่งวันถัดไป)",
            "type": 0,
