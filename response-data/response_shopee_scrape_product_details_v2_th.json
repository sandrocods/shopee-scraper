    "product_description": {
      "paragraph_list": [
        {
          "text": "ตั้งแต่ปี พ.ศ.2516 เราได้ค้นหาส่วนผสมคุณภาพสูงสุดจากทั่วโลก เพื่อเชื่อมโยงคุณกับอาหารเสริมที่มีประสิทธิภาพมากที่สุดที่ช่วยให้คุณมีชีวิตที่สดใสขึ้น และรับมือกับช่วงเวลาที่สำคัญที่สุดในชีวิต",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
