      "paragraph_list": [
        {
          "text": "Selfie Stick Stabilize Tripod รุ่น L08",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": "ไม้กันสั่นไฟฟ้า สำหรับสมาร์ทโฟน ✨",
          "type": 0,
          "ratio": null,
          "img_id": null,
