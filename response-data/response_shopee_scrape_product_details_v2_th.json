    "product_description": {
      "paragraph_list": [
        {
          "type": 0,
          "text": "ต้องการเร็วและมีปัญหาน้อยเลือกkerryค่ะ",
          "img_id": null,
          "ratio": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "type": 0,
          "text": "※สินค้ามีพร้อมส่งตามสต็อคสีใหม่สวยๆ เลือกสีลงรถเข็นก่อนแล้วค่อยซื้อพร้อมกันนะคะ",
