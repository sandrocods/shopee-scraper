    "product_description": {
      "paragraph_list": [
        {
          "text": "เครื่องพ่นยาแบตเตอรี่ ยี่ห้อ ช้าง",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": "- ถังพ่นยามีให้เลือกขนาด  20 ลิตร",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": "- ก้านพ่นยาอลูมิเนียม สามารถปรับยืด-หดได้",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": "- หัวพ่นยามีแถมให้ 4 แบบ",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": "- อุปกรณ์ในกล่องครบ",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": "- แบตเตอรี่ 12V8AH มาพร้อมตัวชาร์ทไฟ",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": "- มีไฟแสดงสถานะการทำงาน",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": "- สวิซต์เปิดปิด และควบคุมความแรงการทำพ่น",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": "- ถัง หนา เหนียว เกรดพรีเมียม พื้นสามารถเปิดเพื่อเซอร์วิสได้ง่าย",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": "- ถัวพลาสติกเหนียว ทนทาน ไม่แตกหักง่าน",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": "** กรณี ปั้มไม่ทำงาน ** ( ขั้วแบตหลวม )",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": "1. เปิดฝาใต้ถัง",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": "2. ถอดแบตออกมาขยับ ขั้วแบต",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": "** กรณีปั้มทำงาน แต่น้ำไม่ออก ** ( อากาศบล็อค )",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": "1. นำน้ำออกจากตัวถังให้หมด",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": "2. นำสายยางบ้านฉีดน้ำลงไปในรูในถัง ขณะเปิดเครื่อง",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": "3. หรืออีกวิธี ถอดมือบีบออก แล้วเอาปากดูดสายยางดำ ขณะเปิดเครื่อง",
