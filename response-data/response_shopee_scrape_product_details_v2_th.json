    "product_description": {
      "paragraph_list": [
        {
          "text": "Greater Pharma : มายบาซิน น้ำยาบ้วนปาก สูตรไวท์ โพรเทคชั่น 500 มิลลิลิตร",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": null,
          "type": 10001,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": 1
        },
        {
          "text": "ใช้บ้วนปากเพื่อขจัดแบคทีเรียในช่องปาก อันเป็นสาเหตุของการเกิดคราบหินปูนและกลิ่นปาก ลมหายใจสะอาด สดชื่น",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": null,
          "type": 10001,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": 1
        },
        {
          "text": "• ลดการสะสมของแบคทีเรีย สาเหตุหลักของการเกิดกลิ่นปาก",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": "• ให้ความรู้สึกเย็นสบายในช่องปากด้วยสูตรพิเศษ",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": "• ปกป้องฟันขาวไม่ให้คราบต่างๆ ก่อตัวจับฟันได้ง่าย",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": "• สูตรปราศจากแอลกอฮอล์และน้ำตาล",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": "• ลดอาการบวกอักเสบของเหงือกและแผลในช่องปาก",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": "• สามารถใช้ได้เป็นประจำทุกวัน",
          "type": 0,
          "ratio": null,
          "img_id": null,
