          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": "- Altura Total: 0,98m",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": "- Altura do Braço: 0,64m",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": "- Largura : 1,50m",
