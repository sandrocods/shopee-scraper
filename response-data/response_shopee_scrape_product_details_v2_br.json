    "product_description": {
      "paragraph_list": [
        {
          "text": "O Grupo PEPE PARTS atua há mais de 15 anos oferecendo uma ampla variedade de produtos e soluções com qualidade para automóveis, casa, trabalho e muito mais.",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": null,
          "type": 10001,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": 1
        },
        {
          "text": "- Produtos à pronta entrega;",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": "- Nota Fiscal e Garantia;",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": "- Atendimento especializado pela plataforma Shopee.",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": null,
