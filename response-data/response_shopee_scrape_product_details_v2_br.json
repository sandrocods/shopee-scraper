          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": 1
        },
        {
          "text": "O Copo Whisky Capri com capacidade para 340ml, a praticidade que você precisa em seu dia a dia.",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
