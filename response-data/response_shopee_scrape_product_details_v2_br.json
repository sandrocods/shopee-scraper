    "product_description": {
      "paragraph_list": [
        {
          "text": "Um copo de vitamina de vidro de qualidade é uma escolha excelente para servir uma variedade de bebidas, especialmente vitaminas e smoothies. Aqui está um breve resumo destacando sua qualidade:",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
