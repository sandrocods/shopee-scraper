          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": 1
        },
        {
          "text": "100% natural e com um dulçor suave que vem da natureza.",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
