    "product_description": {
      "paragraph_list": [
        {
          "text": "🧺 Jumbolita Multi-Purpose Household Organizer (Stock No. 2529)",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": "Welcome to the Artify Official Store! Declutter your home and maximize your storage space with the Jumbolita Multi-Purpose Household Organizer. Designed with convenience and space-saving in mind, these versatile baskets are perfect for keeping every room in your house neat and tidy.",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": "🌟 Key Features:",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": "Smart Stackable Design: Features a secure lid that allows you to safely stack multiple organizers on top of each other, maximizing your vertical storage space in cabinets and on shelves.",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": "Included Lid Cover: Keeps your stored items protected from dust and dirt while providing a flat surface for stable stacking.",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": null,
          "type": 10001,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": 1
        },
        {
          "text": "Convenient Pull Handle: Equipped with a sturdy handle on the front, making it incredibly easy to grab and pull the basket down from high pantry shelves or deep cabinets.",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": "Ventilated Basket Weave: The breathable slotted design ensures excellent air circulation, making it ideal for storing pantry items, bathroom toiletries, and kitchen supplies.",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": "Perfect Dimensions: Measures D24 x W15 x H11.5 cm, offering a practical size that fits well in most standard cupboards and shelving units.",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": "Aesthetic Muted Colors: Comes in clean, modern colors that easily blend with any home decor style.",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": null,
          "type": 10001,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": 1
        },
        {
          "text": "Proudly Philippine Made: An authentic \"Product of the Philippines\" from the trusted Jumbolita Homeware brand.",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": "Take control of your clutter with a smart, stackable storage solution. Add these multi-purpose organizers to your cart today! 🛒",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        }
      ],
