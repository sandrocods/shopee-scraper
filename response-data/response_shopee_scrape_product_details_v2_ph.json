          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": "• Non-Sticky",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": "• Light feel",
          "type": 0,
