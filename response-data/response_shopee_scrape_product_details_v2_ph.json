    "product_description": {
      "paragraph_list": [
        {
          "text": "Features:",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": "This projector features 1280*720 physical resolution, maximum supports 1080P resolution, true color contrast ratio ensures excellent viewing experience, smooth and clear picture, more outstanding details.",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": "Adopt environment-friendly LED light source, diffuse reflection imaging, soft light, long time watching without fatigue.",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": "0.8M-3.8M projector distance, you can freely adjust according to your needs.",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": "Mobile phone and projector can share the same screen wired or wirelessly.",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": "Trapezoidal correction, you can enjoy big screen by adjusting the distance when watching movies, playing games and singing.",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": "Multiple ports design, equipped with USB, AV, VGA and headphone jack to meet diversified office or entertainment needs.",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": null,
