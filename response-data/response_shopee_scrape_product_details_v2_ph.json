        },
        {
          "text": "• UVA UVB protection spf50 PA++++ Broad Spectrum",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": "• 3 in 1 Mattifying sunscreen protection",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
