    "product_description": {
      "paragraph_list": [
        {
          "text": "🌟 Step up your street style with our Washed Letter Embroidered Baseball Cap—where hip-hop edge meets sun-safe functionality for all!​",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": null,
          "type": 10001,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": 1
        },
        {
          "text": "🧢 Product Features: Crafted from soft, breathable cotton, this adjustable cap features retro washed letter embroidery and a curved \"duckbill\" brim, delivering a bold personalized street aesthetic. The one-size-fits-most design (adjustable strap fits 56-60cm) suits men and women, while the dome-shaped crown and UV-protective brim shield against harsh rays during outdoor adventures, beach trips, or urban explorations.",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": null,
          "type": 10001,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": 1
        },
        {
          "text": "✨Perfect for hip-hop enthusiasts, trendsetters, and anyone seeking a statement accessory that blends fashion with sun protection—pair with streetwear, athleisure, or casual outfits to elevate any look.​",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": null
        },
        {
          "text": null,
          "type": 10001,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
          "empty_paragraph_count": 1
        },
        {
          "text": "📸 Important Notes: Color and embroidery texture may vary slightly due to monitor settings. Minor strap adjustment deviations (1-2cm) are normal for customizable fits—part of its user-friendly design.",
          "type": 0,
          "ratio": null,
          "img_id": null,
          "description_type": 1,
